# Имя конфигурации из configs/<name>.yaml
APP_CONFIG=android.local

# --- Переопределения отдельных полей конфига ---
# Приоритет: APPIUM_* (раскомментированные) > YAML-профиль > дефолты AppConfig.
# Задавать только то, что нужно перебить; остальное берётся из YAML.
# Эквивалент значениям android.local.real.yaml — подставить своё.

# Платформа автоматизации: android | ios
# APPIUM_PLATFORM=android

# Путь к сборке (APK/IPA) или URL сборки в облаке
# APPIUM_APP=resources/app/app-google-release-v2.15.0.apk

# Версия ОС устройства (например, 15), влияет на матчинг устройства
# APPIUM_PLATFORM_VERSION=15

# Имя устройства для Appium (для Android — модель или авд-имя)
# APPIUM_DEVICE_NAME=sm-s21fe

# Жёсткая привязка к конкретному физическому устройству (UDID из `adb devices`)
# — гарантирует выбор телефона, а не эмулятора
# APPIUM_UDID=R5CT21KZN7E

# URL Appium-сервера (локальный по умолчанию, для BrowserStack — свой)
# APPIUM_REMOTE_URL=http://127.0.0.1:4723

# Сохранять данные приложения между сессиями (true: без сброса — быстрый
# старт, состояние переходит между запусками; false: pm clear перед каждой
# сессией — чистое состояние, как после установки)
# APPIUM_NO_RESET=true

# Полный сброс: удалить и заново установить APK при старте сессии.
# Гуще no_reset — используйте, только если нужно проверить first-launch
# с нуля (установка + onboarding)
# APPIUM_FULL_RESET=false

# Таймаут (сек) на паузу между командами pytest → Appium: если дольше —
# сессия закрывается автоматически. Поднимайте, если тесты падают
# "session terminated" при долгих ожиданиях; дефолт Appium — 60
# APPIUM_NEW_COMMAND_TIMEOUT=300

# Автоматическая выдача RUNTIME-разрешений при старте сессии: Appium сам
# делает pm grant (Android) / WDA тапает «Allow» на alert (iOS) — системный
# диалог «Разрешить отправку уведомлений?» не появится даже при первом
# запуске приложения. Выключать нужно только тестам, проверяющим сами
# диалоги как UI (тогда закрывать их явным pages.common.grant_permissions()).
# APPIUM_AUTO_GRANT_PERMISSIONS=true

# --- Управление сервером, который фикстура поднимает сама ---
# Влияют только на сервер, запущенный pytest-фикстурой, когда на remote_url
# ничего не отвечает. На внешний сервер (ручной запуск, CI) — нет: там флаги
# задаются при его старте.

# Эквивалент CLI-флага `appium server --session-override`: при новом
# createSession принудительно закрывать зависшую сессию того же клиента.
# Лечит «could not proxy command» после прерванного/упавшего прогона
# APPIUM_SERVER_SESSION_OVERRIDE=false

# Уровень логов сервера (info|debug|warn|error). debug пригодится для
# разбора падений: в reports/appium_server.log попадут все команды
# и ответы драйвера
# APPIUM_SERVER_LOG_LEVEL=info

